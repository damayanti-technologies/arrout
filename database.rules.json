{
  "rules": {
    "users": {
      "$userId": {
        ".read": "auth != null && auth.uid === $userId",
        ".write": "auth != null && auth.uid === $userId",
        ".validate": "newData.hasChildren(['userId']) && newData.child('userId').val() === $userId"
      }
    },
    "rooms": {
      "$roomId": {
        ".read": true,
        ".write": true,
        ".validate": "newData.hasChildren(['code'])"
      }
    },
    "tournaments": {
      "$weekId": {
        ".read": true,
        "scores": {
          ".read": true,
          ".indexOn": ["points", "updatedAt"],
          "$userId": {
            ".write": "auth != null && auth.uid === $userId",
            ".validate": "newData.hasChildren(['uid', 'points']) && newData.child('uid').val() === $userId && newData.child('points').isNumber() && newData.child('points').val() >= 0"
          }
        }
      }
    },
    "battles_queue": {
      ".read": true,
      "$userId": {
        ".write": true
      }
    },
    "$other": {
      ".read": false,
      ".write": false
    }
  }
}
